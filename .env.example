# ==============================================================================
# Psychology Clinic Bot & Web Application - Environment Variables
# Copy this file to .env and configure the secrets appropriately for deployment.
# NEVER commit the real .env file or live secrets into version control.
# ==============================================================================

# Telegram Bot Token (obtained from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Flask Secret Key for session cookies and CSRF protection
FLASK_SECRET_KEY=change_me_to_a_cryptographically_secure_random_key

# Administrative Telegram User IDs (comma-separated integers)
ADMIN_IDS=56073956,8034655716,95033750

# Clinic Reception Contact Details
ADMIN_USERNAME=drshafaei_psychological_clinic
ADMIN_PHONE=09213689461
CLINIC_WEBSITE=https://drshafaeiclinic.ir/

# Automated Reporting SMTP Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=clinic_sender@example.com
SENDER_PASSWORD=your_email_app_password_here
RECEIVER_EMAIL=clinic_receiver@example.com

# Optional Storage Paths (defaults to clinic.db and private_uploads/ in project root)
# DB_PATH=/opt/psychology_bot/clinic.db
# PRIVATE_UPLOADS_DIR=/opt/psychology_bot/private_uploads
